{
  "name": "citrate-atlas",
  "version": "0.1.0",
  "private": true,
  "description": "Citrate Atlas, the gated, agentic documentation webapp for the Citrate Network federation.",
  "scripts": {
    "content": "node scripts/build-content.mjs",
    "predev": "node scripts/build-content.mjs",
    "prebuild": "node scripts/build-content.mjs",
    "postbuild": "node scripts/check-no-confidential.mjs && npm run check:auth-mode",
    "dev": "NEXT_PUBLIC_AUTH_MODE=mock ALLOW_MOCK_AUTH=1 next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check:auth-mode": "node --experimental-strip-types scripts/check-auth-mode.mjs",
    "verify:bundle": "node scripts/check-no-confidential.mjs && npm run check:auth-mode",
    "content-lint": "node scripts/content-lint.mjs",
    "sbom": "npm sbom --sbom-format cyclonedx --omit dev > sbom.cyclonedx.json",
    "docs:api": "node scripts/gen-api-refs.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.48",
    "ai": "^6.0.193",
    "jose": "^6.2.3",
    "mermaid": "^11.15.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0"
  }
}
