{
  "name": "citrate-codex",
  "version": "0.1.0",
  "private": true,
  "description": "Citrate Codex — gated, agentic documentation webapp (S1 app shell, wired to prototype fixtures).",
  "scripts": {
    "content": "node scripts/build-content.mjs",
    "predev": "node scripts/build-content.mjs",
    "prebuild": "node scripts/build-content.mjs",
    "postbuild": "node scripts/check-no-confidential.mjs",
    "dev": "NEXT_PUBLIC_AUTH_MODE=mock ALLOW_MOCK_AUTH=1 next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "verify:bundle": "node scripts/check-no-confidential.mjs",
    "sbom": "npm sbom --sbom-format cyclonedx --omit dev > sbom.cyclonedx.json"
  },
  "dependencies": {
    "jose": "^6.2.3",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0"
  }
}
