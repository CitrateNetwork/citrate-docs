{
  "name": "citrate-atlas",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "description": "Citrate Atlas, the gated, agentic documentation webapp for the Citrate Network federation.",
  "//": "Post-reroll sync (README.md, Chain-generated pages): npm run docs:addresses -- --chain ../citrate-chain && npm run docs:precompiles -- --chain ../citrate-chain && npm run content",
  "scripts": {
    "content": "node scripts/build-content.mjs",
    "predev": "node scripts/gen-changelog.mjs && node scripts/build-content.mjs",
    "prebuild": "node scripts/gen-changelog.mjs && node scripts/build-content.mjs",
    "postbuild": "node scripts/check-no-confidential.mjs && npm run check:bundle-gate && npm run check:auth-mode && npm run check:access-clock && npm run check:mcp-keys",
    "dev": "NEXT_PUBLIC_AUTH_MODE=mock ALLOW_MOCK_AUTH=1 next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:auth-mode": "node --experimental-strip-types scripts/check-auth-mode.mjs",
    "check:access-clock": "node --experimental-strip-types scripts/check-access-clock.mjs",
    "check:mcp-keys": "node --experimental-strip-types scripts/check-mcp-keys.mjs",
    "check:bundle-gate": "node scripts/check-bundle-gate-selftest.mjs",
    "verify:bundle": "node scripts/check-no-confidential.mjs && npm run check:bundle-gate && npm run check:auth-mode && npm run check:access-clock && npm run check:mcp-keys",
    "content-lint": "node scripts/truth-lint.mjs && node scripts/content-lint.mjs",
    "sbom": "npm sbom --sbom-format cyclonedx --omit dev > sbom.cyclonedx.json",
    "docs:api": "node scripts/gen-api-refs.mjs",
    "docs:addresses": "node scripts/gen-addresses.mjs",
    "docs:precompiles": "node scripts/gen-precompiles.mjs",
    "docs:chain-check": "node scripts/gen-addresses.mjs --check && node scripts/gen-precompiles.mjs --check",
    "docs:changelog": "node scripts/gen-changelog.mjs",
    "docs:freshness": "node scripts/gen-freshness.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.48",
    "ai": "^6.0.193",
    "jose": "^6.2.3",
    "mermaid": "^11.15.0",
    "next": "^16.3.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "katex": "^0.18.11"
  }
}
