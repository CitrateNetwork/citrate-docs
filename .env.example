# Citrate Codex — auth (S2). FAIL-CLOSED: unset / "dev" / "oidc" / any unknown value ALL resolve to the
# real citrate-identity oidc path (server-verified JWT). The fixture tier-switcher (no IdP needed) is
# NEVER the default — it activates ONLY for the explicit "mock" flag in a NON-production build
# (see package.json "dev": NEXT_PUBLIC_AUTH_MODE=mock ALLOW_MOCK_AUTH=1). Do not set "mock" in production
# unless you also set ALLOW_MOCK_AUTH=1 for a non-public staging box.
NEXT_PUBLIC_AUTH_MODE=oidc          # oidc (default/prod) | mock (dev-only fixtures)

# ── OIDC (citrate-identity, auth.citrate.ai) — required when NEXT_PUBLIC_AUTH_MODE=oidc ──
# Server verifies tokens fail-closed: ISSUER + AUDIENCE + JWKS must ALL be set or every token is rejected.
OIDC_ISSUER=https://auth.citrate.ai
OIDC_AUDIENCE=                     # this RP's client_id (per-RP token isolation, FUA-EXPLORER-01)
OIDC_JWKS_URL=https://auth.citrate.ai/jwks   # live IdP serves JWKS here (NOT /.well-known/jwks.json)
OIDC_AUTH_ENDPOINT=https://auth.citrate.ai/auth
OIDC_TOKEN_ENDPOINT=https://auth.citrate.ai/token
OIDC_END_SESSION_ENDPOINT=https://auth.citrate.ai/session/end
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=                # omit for a public PKCE client
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback
OIDC_SCOPES=openid profile wallet kyc offline_access

# Entitlement: citrate-identity does NOT yet mint an `entitlement` claim — Codex resolves tier RP-side
# from kyc_status + the entitlements source (prototype: fixtures; prod: the seat/contracts table +
# operators roster + auditor enrollments). See lib/auth/entitlement.ts + PLANSET/07 §2.

# ── MCP server API keys (app/api/mcp) — DOC-B-003 ──
# The MCP toolbox caps an external agent's tier by API key. Keys are HASH-AT-REST: never a plaintext
# key→tier literal in source. MCP_API_KEYS is a JSON object keyed by the SHA-256 (hex) of the API key:
#   { "<sha256hex>": { "tier": "commercial", "sub": "org:acme", "expiresAt": 1790000000000 } }
# Unset/malformed env, an unknown key, or an expired key all resolve to "public" (fail-closed). Mint hex
# with:  node -e 'console.log(require("crypto").createHash("sha256").update("YOUR_KEY").digest("hex"))'
# Keys must be random and at least 32 characters (PBA R2): generate with `openssl rand -base64 32`.
# Shorter keys never resolve, even if their hash is in the store.
# MCP_API_KEYS={}

# Staging only: allow the unsigned mock path in a non-public deploy.
# ALLOW_MOCK_AUTH=1

# ── Ask Atlas inference (citrate-inference-gateway) — same seam as citrate-explorer ──
# Mode selects the OpenAI-compatible backend. Default "gateway" hits the live gateway below; if it is
# unreachable, Ask falls back to a deterministic extractive answer (so docs still respond).
CITRATE_INFERENCE_MODE=gateway     # gateway | local | onchain (onchain not wired)
CITRATE_GATEWAY_URL=https://infer.citrate.ai/v1   # gateway baseURL (note the /v1; client appends /chat/completions)
CITRATE_GATEWAY_API_KEY=           # bearer key the gateway requires (server-only; never NEXT_PUBLIC_)
CITRATE_MODEL_NAME=gemma-4-E4B-it-Q4_K_M          # model id the gateway serves
# Local-droplet mode (CITRATE_INFERENCE_MODE=local) talks to your own OpenAI-compatible server:
# CITRATE_INFERENCE_URL=http://127.0.0.1:8080/v1
# CITRATE_INFERENCE_API_KEY=
# Context budget (small-context served models): cap the answer length.
# CITRATE_MAX_OUTPUT_TOKENS=896

# ── Live sandboxes (chain 40204, read-only) ──
# CITRATE_RPC_URL=https://rpc.citrate.ai          # default; override if needed
# CITRATE_RELAY_URL=                              # EIP-2771 relay (gasless sandbox); 503 until set
# CITRATE_X402_URL=                               # x402 facilitator (x402 sandbox); 503 until set

# --- Live knowledge-graph (mem-gateway) for Ask Atlas (lib/ai/memory.ts) -------
# When set, Ask grounds answers in the live citrate-memories DAG over MCP, in
# addition to the frozen docs. Tier-filtered: only repos the caller may read are
# queried, so confidential graph content never reaches an unauthorized asker.
MEM_GATEWAY_URL=https://mem-gateway.citrate.ai
MEM_CONNECT_SECRET=                 # MUST byte-match the gateway's MEM_CONNECT_SECRET
MEM_SERVICE_SUB=svc:atlas           # read-only service membership on the gateway
# Optional tuning:
# MEM_SEARCH_PER_REPO=4             # hits requested per repo
# MEM_SEARCH_TOPK=12                # max memory chunks merged into the prompt
# MEM_SEARCH_TIMEOUT_MS=12000
# MEM_RECALL_REPOS=citrate-federation,citrate-docs   # also pull a recent-history storyline (off by default)
# MEM_RECALL_BUDGET=4               # recent nodes per recall repo
# MEM_DEFAULT_TIER=confidential    # tier for repos NOT in MEMORY_REPO_TIERS (FAIL CLOSED; set "public" only to deliberately open all federation memory to anonymous askers)
# MEMORY_REPO_TIERS is MERGED OVER the built-in confidential defaults (citrate-security/-commercial/
#   -compliance/-federation), never a whole-map replacement (DOC-B-009) — set it only to ADD or RAISE
#   entries. Explicitly DEMOTING a built-in confidential repo below its floor fails the boot assertion.
# MEMORY_REPO_TIERS={"my-new-private-repo":"confidential"}
# MEMORY_REPOS=...                  # comma-separated override of the repo list
